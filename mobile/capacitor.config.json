{
  "appId": "com.hotportion.grill",
  "appName": "Hot Portion Grill",
  "webDir": "frontend",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "allowNavigation": [
      "hotportion.netlify.app",
      "hotportion.onrender.com",
      "*.onrender.com",
      "https://localhost"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "ios": {
    "scheme": "HotPortion",
    "contentInset": "automatic",
    "backgroundColor": "#E53935",
    "allowsLinkPreview": false,
    "preferredContentMode": "mobile",
    "limitsNavigationsToAppBoundDomains": false,
    "localizedStrings": {
      "NSLocationWhenInUseUsageDescription": "Hot Portion needs your location to suggest nearby pickup options.",
      "NSPhotoLibraryUsageDescription": "Hot Portion uses your photo library for profile pictures.",
      "NSCameraUsageDescription": "Hot Portion uses your camera to take profile photos.",
      "NSMicrophoneUsageDescription": "Hot Portion uses your microphone for voice search."
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#E53935",
      "androidScaleType": "CENTER_CROP",
      "iosSplash": {
        "show": true,
        "backgroundColor": "#E53935",
        "launchStoryboard": "SplashScreen"
      }
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK",
      "backgroundColor": "#ffffff"
    },
    "CapacitorCookies": {
      "enabled": true
    },
    "CapacitorUpdater": {
      "autoUpdate": true,
      "statsUrl": "https://api.capgo.app/stats",
      "channel": "production"
    }
  }
}
